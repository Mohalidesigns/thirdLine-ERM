{
    "name": "thirdline/platform",
    "description": "Platform primitives shared by the ThirdLine GRC products: tenancy, licensing, activity logging, rich text, authorization and the middleware that enforces them.",
    "type": "library",
    "license": "proprietary",
    "version": "0.1.0",
    "require": {
        "php": "^8.2",
        "illuminate/contracts": "^11.0|^12.0",
        "illuminate/database": "^11.0|^12.0",
        "illuminate/support": "^11.0|^12.0",
        "spatie/laravel-permission": "^6.0|^7.0"
    },
    "require-dev": {
        "orchestra/testbench": "^9.0|^10.0",
        "phpunit/phpunit": "^11.0"
    },
    "autoload": {
        "psr-4": {
            "ThirdLine\\Platform\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "ThirdLine\\Platform\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit"
    },
    "extra": {
        "laravel": {
            "providers": [
                "ThirdLine\\Platform\\PlatformServiceProvider"
            ]
        }
    },
    "config": {
        "sort-packages": true
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
