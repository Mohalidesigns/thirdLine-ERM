<?xml version="1.0" encoding="UTF-8"?>
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="vendor/phpunit/phpunit/phpunit.xsd"
         bootstrap="vendor/autoload.php"
         colors="true"
>
    <testsuites>
        <testsuite name="Unit">
            <directory>tests/Unit</directory>
        </testsuite>
        <testsuite name="Feature">
            <directory>tests/Feature</directory>
        </testsuite>
    </testsuites>
    <source>
        <include>
            <directory>app</directory>
        </include>
    </source>
    <php>
        <!-- The WP-04 performance test builds a 5,000-risk register in
             memory to prove the 12-period trend query does not scale with the
             row count, and PHP's 128M default is well below that — so the
             limit is set here rather than left to whatever php.ini the CI
             image ships with.

             RAISED FROM 512M IN TPRM PHASE 5. A full run peaked at 499 MB
             before the TPRM module's tests existed, which was close enough to
             512 that the next few hundred tests tipped it over — and the
             failure is a fatal error partway through the run rather than a
             test failure, so it reads as a broken suite rather than a limit
             that needs raising. Note that this value overrides `php -d` on the
             command line, which is why raising it here is the only way to
             raise it at all. -->
        <ini name="memory_limit" value="1G"/>
        <env name="APP_ENV" value="testing"/>
        <env name="APP_MAINTENANCE_DRIVER" value="file"/>
        <env name="BCRYPT_ROUNDS" value="4"/>
        <env name="BROADCAST_CONNECTION" value="null"/>
        <env name="CACHE_STORE" value="array"/>
        <!--
            MariaDB, not SQLite in memory, and not MySQL either.

            Production is MariaDB 10.4 — the hosting panel says "MySQL" and the
            server does not — and developers run 10.4.28 locally, so this is the
            engine the suite has to answer for. SQLite in memory was quick and
            proved the wrong thing; MySQL 8 is worse than useless here, because
            it has the CTEs, window functions and native JSON type that MariaDB
            10.4 largely does not, so it goes green on SQL production cannot run.
            MariaDB stores a `json` column as LONGTEXT behind a `json_valid()`
            CHECK constraint, and the two engines fail differently.

            It costs speed — minutes rather than ninety seconds — and it makes a
            running MariaDB a prerequisite for the suite. `DB_DATABASE` is
            deliberately a SEPARATE database from the development one, because
            RefreshDatabase drops every table it finds: point this at `risk` and
            the first test run destroys the developer's working data.

            Credentials are left to `.env` so each developer keeps their own;
            CI sets them explicitly in `.github/workflows/ci.yml`.
        -->
        <env name="DB_CONNECTION" value="mysql"/>
        <env name="DB_HOST" value="127.0.0.1"/>
        <env name="DB_PORT" value="3306"/>
        <env name="DB_DATABASE" value="risk_test"/>
        <env name="MAIL_MAILER" value="array"/>
        <env name="QUEUE_CONNECTION" value="sync"/>
        <env name="SESSION_DRIVER" value="array"/>
        <env name="PULSE_ENABLED" value="false"/>
        <env name="TELESCOPE_ENABLED" value="false"/>
        <env name="NIGHTWATCH_ENABLED" value="false"/>
        <!-- The licensing gate is exercised explicitly by tests/Feature/Licensing;
             every other feature test hits real routes unlicensed. -->
        <env name="LICENSE_ENFORCE_VALID" value="false"/>
    </php>
</phpunit>
