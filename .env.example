APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

# Cookie hardening. SESSION_SECURE_COOKIE must be true wherever the app is
# served over HTTPS — `php artisan app:preflight` fails the deploy otherwise.
SESSION_SECURE_COOKIE=false
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=redis

# ---------------------------------------------------------------------------
# Feature flags (config/features.php). All default to false: a fresh
# environment never exposes a gated surface by accident.
# ---------------------------------------------------------------------------
# Risk Intelligence screens (Forecast, Emerging Risk Radar, Regulatory Pulse).
# Every figure they show is computed from this organisation's own tables — see
# docs/ai-number-provenance.md. Leave off until those tables carry enough
# history for the output to be meaningful.
FEATURE_AI_INTELLIGENCE=false

# TOTP multi-factor authentication. Rebuilt in migration Phase 1 and covered by
# tests; off by default because self-service recovery (backup codes) does not
# exist yet — an administrator clears a lost authenticator. See config/features.php.
FEATURE_MFA_TOTP=false

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# ─────────────────────────────────────────────────────────────────
# Single sign-on (WP-00 TASK 4)
#
# Off by default. Local password login keeps working alongside SSO so a
# misconfigured IdP cannot lock an organization out of its own platform.
# ─────────────────────────────────────────────────────────────────
SSO_ENABLED=false

# Replace an SSO user's roles from the IdP group map on every login, so
# removing them from a group in the directory removes their access here.
SSO_SYNC_ROLES_ON_LOGIN=true

# Create a local account the first time an unknown but authenticated identity
# arrives. Leave false in regulated deployments so someone approves each account.
SSO_AUTO_PROVISION=false
SSO_DEFAULT_ORGANIZATION_ID=

# Microsoft Entra ID (OIDC)
SSO_ENTRA_CLIENT_ID=
SSO_ENTRA_CLIENT_SECRET=
SSO_ENTRA_TENANT=common
SSO_ENTRA_REDIRECT="${APP_URL}/auth/sso/entra/callback"
SSO_ENTRA_GROUPS_CLAIM=groups
SSO_ENTRA_ALLOWED_DOMAINS=

# Google Workspace (OIDC)
SSO_GOOGLE_CLIENT_ID=
SSO_GOOGLE_CLIENT_SECRET=
SSO_GOOGLE_REDIRECT="${APP_URL}/auth/sso/google/callback"
SSO_GOOGLE_ALLOWED_DOMAINS=

# Okta (OIDC)
SSO_OKTA_CLIENT_ID=
SSO_OKTA_CLIENT_SECRET=
SSO_OKTA_BASE_URL=
SSO_OKTA_REDIRECT="${APP_URL}/auth/sso/okta/callback"
SSO_OKTA_GROUPS_CLAIM=groups
SSO_OKTA_ALLOWED_DOMAINS=

# SAML 2.0 is configured per client in the application, not here:
#   Administration -> Settings -> Single Sign-On
# Same for OIDC. The per-provider variables above remain only as a fallback for
# single-tenant installs that have no configuration row. See SECURITY-NOTES.md.


# ─────────────────────────────────────────────────────────────────
# SCIM 2.0 provisioning
#
# Issue a per-organization bearer token with:
#   php artisan scim:token {organization_id} --name="Entra sync"
# ─────────────────────────────────────────────────────────────────
SCIM_ENABLED=false


# ─────────────────────────────────────────────────────────────────
# Local LLM (Ollama)
#
# The platform talks to an Ollama-compatible endpoint on the host. It is local
# and self-hosted on purpose: risk registers, loss events and examination
# findings are exactly the material that must not leave the institution's
# network, and a hosted model would undo the data-residency position the rest
# of the platform is built to hold (see WP-00's self-hosted assets).
#
# Install and pull the model:
#   brew install ollama && ollama serve
#   ollama pull granite4:micro
#
# LLM_ENABLED=false is a hard off switch: LlmService::available() returns false
# and every AI surface shows its non-AI fallback rather than blanking.
# ─────────────────────────────────────────────────────────────────
LLM_ENABLED=false
LLM_DRIVER=ollama
LLM_ENDPOINT=http://localhost:11434
LLM_MODEL=granite4:micro
LLM_TIMEOUT_SECONDS=20
LLM_TEMPERATURE=0.2


# ─────────────────────────────────────────────────────────────────
# Licensing client (migration Phase 0 — imported from ThirdLine)
#
# LICENSE_ENFORCE_VALID=false is the shipping default: the server-side gate
# is not applied to any route group yet, so a validation hiccup cannot lock a
# deployment out. Activate the licence under Administration → License, check
# it validates green, then set true and run `php artisan config:cache`.
# ─────────────────────────────────────────────────────────────────
LICENSE_SERVER_URL=https://license.atherislimited.com
LICENSE_CLIENT_ID=
LICENSE_CLIENT_SECRET=
LICENSE_ENFORCE_VALID=false
# LICENSE_HEARTBEAT_HOURS=48
# LICENSE_GRACE_DAYS=7
# LICENSE_CACHE_TTL=300

# ─────────────────────────────────────────────────────────────────
# Measure engine re-baselining (WP-04)
#
# A threshold is re-baselined when the measure it watches has moved enough to
# make the old band meaningless. TOLERANCE is the proportional move that
# triggers it; ABSOLUTE_FLOOR stops a measure that sits near zero from
# re-baselining on every tick, where a small absolute move is a large
# proportional one.
# ─────────────────────────────────────────────────────────────────
# MEASURE_REBASELINE_TOLERANCE=0.15
# MEASURE_REBASELINE_ABSOLUTE_FLOOR=1

# ─────────────────────────────────────────────────────────────────
# CBN exchange rates
#
# The rate feed behind currency conversion. A rate flows straight into a
# regulatory threshold test, which is why fx_rate.manage is its own permission.
# ─────────────────────────────────────────────────────────────────
# CBN_RATE_URL=
# CBN_RATE_CURRENCIES=USD,GBP,EUR

# ─────────────────────────────────────────────────────────────────
# Webhooks (WP-07)
#
# ALLOW_PRIVATE_HOSTS must stay false outside development: a subscription
# pointed at 169.254.169.254 or an internal address turns the delivery worker
# into a request forgery tool with the platform's own network position.
# ALLOWED_HOSTS is the allowlist consulted when it is false.
# ─────────────────────────────────────────────────────────────────
# WEBHOOKS_ALLOW_PRIVATE_HOSTS=false
# WEBHOOKS_ALLOWED_HOSTS=
# WEBHOOKS_MAX_ATTEMPTS=5
# WEBHOOKS_TIMEOUT_SECONDS=10

# ─────────────────────────────────────────────────────────────────
# Workflow engine (WP-06)
#
# SLA_GRACE_MINUTES is how late a task may be before it escalates.
# ACCEPTANCE_MONTHS is how long a risk acceptance stands before it must be
# reviewed again.
# ─────────────────────────────────────────────────────────────────
# WORKFLOW_SLA_GRACE_MINUTES=60
# WORKFLOW_ACCEPTANCE_MONTHS=12

# ─────────────────────────────────────────────────────────────────
# Connectors (WP-07)
#
# DRY_RUN_FIRST makes a newly configured connector fetch and report without
# writing, so a mis-mapped source is found before it lands in the measure
# engine.
# ─────────────────────────────────────────────────────────────────
# CONNECTORS_DRY_RUN_FIRST=true

# ─────────────────────────────────────────────────────────────────
# SSO — SAML and Entra endpoints
#
# The per-provider settings are held per organisation in the database
# (Administration → SSO). These are the deployment-wide defaults; a blank value
# means the organisation must supply its own.
# ─────────────────────────────────────────────────────────────────
# SSO_SAML_ENTITY_ID=
# SSO_SAML_SSO_URL=
# SSO_SAML_SLO_URL=
# SSO_SAML_IDP_X509_CERT=
# SSO_SAML_SP_X509_CERT=
# SSO_SAML_SP_PRIVATE_KEY=
# SSO_SAML_GROUPS_CLAIM=groups
# SSO_SAML_ALLOWED_DOMAINS=
# SSO_ENTRA_AUTH_URL=
# SSO_ENTRA_TOKEN_URL=
# SSO_ENTRA_USERINFO_URL=
# SSO_GOOGLE_GROUPS_CLAIM=groups

# ─────────────────────────────────────────────────────────────────
# Licensing client — remaining tunables
# ─────────────────────────────────────────────────────────────────
# LICENSE_CLIENT_TOKEN=
# LICENSE_PUBLIC_KEY_PATH=
# LICENSE_MAX_DRIFT=300
# LICENSE_REVOCATION_CHECK_MINUTES=30

# ─────────────────────────────────────────────────────────────────
# API
# ─────────────────────────────────────────────────────────────────
# API_VERSION=v1
